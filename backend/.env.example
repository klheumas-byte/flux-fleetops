FLASK_APP=app.py
FLASK_ENV=production
FLASK_DEBUG=0
DEBUG=false
SECRET_KEY=replace-with-a-secure-random-secret
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-secret
ACCESS_TOKEN_EXPIRES_MINUTES=60
MAX_UPLOAD_SIZE_MB=5
MONGO_URI=mongodb+srv://username:password@cluster-name.mongodb.net/flux_fleet?retryWrites=true&w=majority
MONGO_DB_NAME=flux_fleet
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=5000
MASTER_DATA_SEED_RETRIES=3
MASTER_DATA_SEED_RETRY_DELAY_SECONDS=1.5
CORS_ORIGINS=https://your-frontend-domain.com
CLOUDFLARE_IMAGES_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_IMAGES_PUBLIC_VARIANT=
CLOUDFLARE_IMAGES_THUMBNAIL_VARIANT=
MAINTENANCE_REMINDER_SWEEP_ENABLED=true
MAINTENANCE_REMINDER_SWEEP_INTERVAL_MINUTES=15
MAINTENANCE_REMINDER_SWEEP_BATCH_SIZE=50
