# Single API origin used by every frontend request. Include the /api prefix.
VITE_API_BASE_URL=/api
VITE_DEV_API_TARGET=http://127.0.0.1:5001

# Optional backend-only bootstrap secret for newly provisioned Smart Living users.
# Leave unset to use the migration fallback; never expose this through VITE_*.
SMARTLIVING_TEMPORARY_PASSWORD=fleet@12345
